# PaperNinja — copy to .env and fill in

# Invoice Ninja
INVOICE_NINJA_URL=https://invoicing.example.com
INVOICE_NINJA_TOKEN=

# Paperless-ngx
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_TOKEN=

# App data (password hash + session secret live in $DATA_DIR/auth.json)
DATA_DIR=data
# Set true behind HTTPS so the session cookie is Secure
SESSION_HTTPS=false

# Invoice Ninja expense custom field slots (custom_value1 … custom_value4)
# Use Setup → Felder in the UI to discover labels and copy values.
IN_EXPENSE_FIELD_INVOICE_NUMBER=custom_value1
IN_EXPENSE_FIELD_PAPERLESS_URL=custom_value2

# Paperless custom field IDs (integers)
PL_FIELD_INVOICE_NUMBER=
PL_FIELD_EXPENSE_NUMBER=
PL_FIELD_INVOICE_NINJA_URL=
# Optional: monetary field used for amount matching
PL_FIELD_AMOUNT=

# Reverse queue: only unlinked Paperless docs with this tag (name or numeric ID)
PL_REVERSE_QUEUE_TAG=

# Audit log size cap in bytes (default 1 MiB, stored in $DATA_DIR/audit.log)
AUDIT_LOG_MAX_BYTES=1048576

# Matching
MATCH_DATE_WINDOW_DAYS=7
MATCH_AMOUNT_TOLERANCE=0.02
MATCH_MIN_SCORE=40
MATCH_TOP_N=5

# URL templates ({id} = entity id)
IN_EXPENSE_URL_TEMPLATE={base}/expenses/{id}/edit
PL_DOCUMENT_URL_TEMPLATE={base}/documents/{id}/
